// FundamentalOS — ASI matchmaker overview client (prebuilt).
//
// Client library that talks to the on-device Android System Intelligence (ASI,
// com.google.android.as) ContentSuggestions service. Required by
// com.android.systemui.fundamental.screenshot.ScreenshotNotificationSmartActionsProviderGoogle.
// Extracted from the Pixel SystemUIGoogle build; the runtime service is provided by the ASI
// prebuilt already shipped in vendor/google/<device>/proprietary.
java_import {
    name: "fundamental-matchmaker-lib",
    sdk_version: "current",
    jars: ["libs/com.google.android.apps.miphone.aiai.matchmaker.overview.jar"],
}
