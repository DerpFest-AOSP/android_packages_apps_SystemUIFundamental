  ~ Info row pinned to the top of the container (UDFPS devices, icon/text sit below the sensor).
  -->
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Constraint
        android:id="@+id/ambient_indication_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ambient_indication_container_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Constraint
        android:id="@+id/ambient_indication_icon"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp" />
    <Constraint
        android:id="@+id/ambient_indication_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</ConstraintSet>
